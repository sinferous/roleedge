# Copy to .env.local and fill in. Variables without NEXT_PUBLIC_ are server-only secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stand-ins used until the real services exist (see docs/SETUP.md).
# file | supabase
DATA_PROVIDER=file
# console | resend
EMAIL_PROVIDER=console
# mock | calcom | zoho
BOOKING_PROVIDER=mock
# local | supabase
AUTH_PROVIDER=local

# Local admin sign-in (AUTH_PROVIDER=local only; refused in production).
# First email is the owner. Password must be 12+ characters.
ADMIN_EMAILS=info@roleedge.com
ADMIN_LOCAL_PASSWORD=
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
RATE_LIMIT_SALT=

# Show stories that are still pending client approval (never shown in production).
SHOW_PENDING_CONTENT=true

# Real services (fill in before go-live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
RESEND_API_KEY=
EMAIL_FROM="RoleEdge <hello@roleedge.com>"
EMAIL_TEAM_INBOX=info@roleedge.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
